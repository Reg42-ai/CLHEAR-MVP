{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clhear.org/conformance/self_assessment.schema.json",
  "title": "CLHEAR Annex E self-assessment submission",
  "type": "object",
  "required": ["organization", "program", "scope", "release", "blueprint_id", "profile_confirmed", "level_claimed", "items", "signatory"],
  "properties": {
    "organization": {"type": "string", "minLength": 2, "maxLength": 200},
    "program": {"type": "string", "minLength": 2, "maxLength": 200, "description": "e.g. AML/CTF program"},
    "scope": {"type": "string", "minLength": 40, "maxLength": 4000, "description": "entities, business lines, jurisdictions; exclusions with reasons"},
    "release": {"type": "string", "minLength": 1, "description": "CLHEAR release id"},
    "blueprint_id": {"type": "string", "pattern": "^BLU-[0-9]{6}$"},
    "profile_confirmed": {"type": "boolean", "const": true},
    "level_claimed": {"type": "string", "enum": ["CL1", "CL2"]},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "status"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^ITM-[0-9]{6}$"},
          "status": {"type": "string", "enum": ["operated", "out_of_scope"]},
          "owner": {"type": "string", "maxLength": 200, "description": "accountable role; required when operated"},
          "reason": {"type": "string", "maxLength": 1000, "description": "a fact about the organisation; required when out_of_scope"},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ref", "kind"],
              "properties": {
                "ref": {"type": "string", "minLength": 1, "maxLength": 500, "description": "document id, URL, system name or file hash — never the content"},
                "kind": {"type": "string", "enum": ["policy", "procedure_record", "system_configuration", "appointment", "minutes", "register", "report", "training_record", "other"]},
                "obligation_ids": {"type": "array", "items": {"type": "string"}},
                "template": {"type": "string", "description": "evidence_templates/ file the artefact follows"}
              }
            }
          },
          "deviations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["characteristic", "blueprint_value", "program_value", "rationale"],
              "properties": {
                "characteristic": {"type": "string"},
                "blueprint_value": {},
                "program_value": {},
                "rationale": {"type": "string", "minLength": 1, "maxLength": 1000}
              }
            }
          }
        }
      }
    },
    "change_tracking": {
      "type": "object",
      "properties": {
        "watchlist_id": {"type": "string"},
        "feed": {"type": "string", "description": "feed URL or subscription reference"},
        "sdk": {"type": "string", "description": "integration reference"},
        "last_reconciled_release": {"type": "string"}
      }
    },
    "reconciliation_days": {"type": "integer", "minimum": 0, "maximum": 365},
    "last_review": {
      "type": "object",
      "required": ["date", "reviewer_role", "outcome"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "reviewer_role": {"type": "string"},
        "outcome": {"type": "string"}
      }
    },
    "signatory": {
      "type": "object",
      "required": ["name", "role", "date"],
      "properties": {
        "name": {"type": "string", "minLength": 2},
        "role": {"type": "string", "minLength": 2},
        "date": {"type": "string", "format": "date"}
      }
    },
    "contact_email": {"type": "string", "format": "email"}
  }
}
