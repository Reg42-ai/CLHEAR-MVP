      "ir-6": "Incident Reporting", "pm-9": "Risk Management Strategy", "ra-3": "Risk Assessment", "ra-5": "Vulnerability Monitoring and Scanning",
      "sr-2": "Supply Chain Risk Management Plan", "pt-2": "Authority to Process Personally Identifiable Information",
      "pt-3": "Personally Identifiable Information Processing Purposes"
    }
