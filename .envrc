# CLHEAR-MVP direnv configuration
# This file is safe to commit; secrets should remain in .env (ignored)

# Python virtual environment
layout_python3

# Optional: set default vars for local dev
export REG42_CLHEAR_ENABLED=${REG42_CLHEAR_ENABLED:-1}
export PYTHONPATH=${PYTHONPATH:-"$(pwd)"}

# Show info on entry
[[ -n "${DIRENV_LOG_FORMAT:-}" ]] && echo "direnv: CLHEAR-MVP environment loaded" 